{
  "name": "gambusinas-monitor-hub",
  "version": "0.4.0",
  "private": true,
  "description": "Launcher multi-monitor estilo DisplayFusion para cocina (Electron + Win32)",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "poc": "tsx src/poc/cli.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:installer": "electron-vite build && electron-builder --win nsis",
    "release": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hgartemis3515/gambusinas-monitor-hub.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.2",
    "socket.io-client": "^4.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.gambusinas.monitor-hub",
    "productName": "Gambusinas Monitor Hub",
    "copyright": "Gambusinas",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "GambusinasMonitorHub-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gambusinas Monitor Hub"
    },
    "publish": {
      "provider": "github",
      "owner": "hgartemis3515",
      "repo": "gambusinas-monitor-hub"
    }
  }
}
